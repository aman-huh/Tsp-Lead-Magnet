# Dependencies (Frontend & Backend)
node_modules/
.pnpm-store/
.pnp/
.pnp.*

# Next.js (Frontend)
frontend/.next/
frontend/out/
frontend/build/
.vercel/

# Strapi (Backend)
backend/.tmp/
backend/.strapi/
backend/dist/
backend/build/
backend/exports/
backend/.strapi-updater.json
backend/.strapi-cloud.json
backend/license.txt

# Databases & local dumps
*.sqlite
*.sqlite3
*.db
*.sql

# Media & Uploads (Keeps folder structure, ignores files)
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
*.pem

# Build Caches & Logs (e.g. tsconfig.tsbuildinfo)
*.tsbuildinfo
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Junk
.DS_Store
*.swp

# Migration & temporary scripts
*.mjs
backend/migrate-to-page.mjs
